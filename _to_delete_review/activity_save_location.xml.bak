<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <fragment
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_gravity="center"
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="@dimen/map_height"
        app:layout_constraintBottom_toTopOf="@+id/tableLayout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <TableLayout
        android:id="@+id/tableLayout_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tableLayout_address"
        app:layout_constraintTop_toBottomOf="@+id/map">
        <TableRow
            android:padding="@dimen/location_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:text="@string/cordinates"
                android:fontFamily="@font/roboto_light"/>
            <TextView
                android:id="@+id/lat_long"
                android:paddingLeft="@dimen/lat_long_padding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="2"
                android:text="@string/cordinates_value"
                android:fontFamily="@font/roboto_light"/>
        </TableRow>
    </TableLayout>
    <TableLayout
        android:id="@+id/tableLayout_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav_view"
        app:layout_constraintTop_toBottomOf="@+id/map">
        <TableRow
            android:gravity="center_horizontal"
            android:padding="@dimen/address_padding"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/address_text_size"
                android:id="@+id/address_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:text="@string/address_header_text"
                android:layout_weight="4"
                android:fontFamily="@font/roboto_bold"/>
        </TableRow>
        <TableRow
            android:gravity="center_horizontal"
            android:padding="@dimen/address_padding"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:text="@string/address"
                android:layout_weight="4"
                android:fontFamily="@font/roboto_light"/>
        </TableRow>
    </TableLayout>
    <TableLayout
        android:id="@+id/tableLayout_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tableLayout_main"
        app:layout_constraintTop_toBottomOf="@+id/map"/>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav_view"
        android:background="@color/bottom_navigation_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_light"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        app:itemIconTint="@color/bottom_navigation_tint_color"
        app:itemTextColor="@color/bottom_navigation_text_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:menu="@menu/menu_navigation_list"/>
    <TableRow
        android:gravity="center_horizontal"
        android:id="@+id/sub_menus_block"
        android:padding="@dimen/sl_sub_menu_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sl_sub_menu_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/map">
        <ImageView
            android:id="@+id/add_favorite"
            android:background="@drawable/icon_design"
            android:layout_width="@dimen/sl_sub_menu_dimen"
            android:layout_height="@dimen/sl_sub_menu_dimen"
            android:layout_marginLeft="@dimen/sl_sub_menu_margin_left"
            android:src="@drawable/favorite_2"
            android:layout_column="0"
            android:onClick="saveLocation"/>
        <ImageView
            android:id="@+id/go_to_google_map"
            android:background="@drawable/icon_design"
            android:layout_width="@dimen/sl_sub_menu_dimen"
            android:layout_height="@dimen/sl_sub_menu_dimen"
            android:layout_marginLeft="@dimen/sl_sub_menu_margin_left"
            android:src="@drawable/gmap_2"
            android:layout_column="1"
            android:onClick="redirectToGoogleMap"/>
        <ImageView
            android:id="@+id/share_location"
            android:background="@drawable/icon_design"
            android:layout_width="@dimen/sl_sub_menu_dimen"
            android:layout_height="@dimen/sl_sub_menu_dimen"
            android:layout_marginLeft="@dimen/sl_sub_menu_margin_left"
            android:src="@drawable/share_2"
            android:layout_column="2"
            android:onClick="shareTheLocation"/>
    </TableRow>
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sl_progress_bar_margin_top"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/map"
        app:layout_constraintVertical_bias="0.049"
        style="?android:attr/progressBarStyleLarge"/>
</androidx.constraintlayout.widget.ConstraintLayout>
